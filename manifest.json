{
  "manifest_version": 3,
  "name": "Smart Definer",
  "version": "1.0",
  "description": "Shows a tooltip with definitions for selected text.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
